From 4b394e668286fcc03996ddd43589205bd7eb4770 Mon Sep 17 00:00:00 2001
From: sternnick review <review@localhost>
Date: Tue, 1 Sep 2026 19:43:37 +0100
Subject: [PATCH] feature: apply per-trial Enable immediately; add the missing
 KA checkbox

ZoneManager read .enabled only inside enableTrialForZone(), which runs on
EVENT_PLAYER_ACTIVATED. Ticking a trial off mid-pull therefore changed
nothing until the player left the zone. refresh() re-reads settings for the
current zone and enables/disables the active trial; all nine Enable rows now
call it.

KA had no Enable row at all (Settings.DEFAULTS.trials.ka.enabled exists and
ZoneManager honours it, but the panel never exposed it) - added for parity.

incha.txt: core/ZoneManager.lua moves above ui/Menu.lua, because Menu now
requires it and the loader resolves requires in manifest order (C-03 in
.review/checks.py guards that ordering).

Evidence, exact line numbers and the reproduction command are in .review/code-review-2026-09-01.md (see finding F-09, F-24).
Verification: static analysis only - not run in-game.
---
 core/ZoneManager.lua | 23 +++++++++++++++++++
 incha.txt            |  2 +-
 ui/Menu.lua          | 53 ++++++++++++++++++++++++++++++++++++--------
 3 files changed, 68 insertions(+), 10 deletions(-)

diff --git a/core/ZoneManager.lua b/core/ZoneManager.lua
index 15c3c42..71fac41 100644
--- a/core/ZoneManager.lua
+++ b/core/ZoneManager.lua
@@ -77,6 +77,29 @@ function ZoneManager.onZoneChanged()
     enableTrialForZone(getPlayerZoneId())
 end
 
+--- Re-evaluate the zone the player is standing in against current settings.
+--- Called from the per-trial Enable checkboxes so a toggle takes effect
+--- immediately; until now .enabled was only consulted at zone-enter time,
+--- which meant the checkbox did nothing until you left and re-entered the
+--- trial (or reloaded the UI).
+function ZoneManager.refresh()
+    local zoneId = getPlayerZoneId()
+    local entry  = trials[zoneId]
+    if not entry then
+        return
+    end
+
+    local sv  = Settings.get()
+    local tsv = sv and entry.trialId and sv.trials[entry.trialId]
+    local wanted = not (tsv and tsv.enabled == false)
+
+    if not wanted and activeTrial == entry.module then
+        disableCurrentTrial()
+    elseif wanted and activeTrial ~= entry.module then
+        enableTrialForZone(zoneId)
+    end
+end
+
 function ZoneManager.getActiveZoneId()
     return activeZoneId
 end
